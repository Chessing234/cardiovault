{
  "name": "cardiovault",
  "version": "0.0.1",
  "private": true,
  "description": "CardioVault monorepo — web, smart contracts, and ML",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w contracts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck -w web",
    "lint": "npm run lint -w web",
    "postinstall": "node -e \"['web','contracts','ml'].forEach(p=>require('fs').accessSync(require('path').join('packages',p,'package.json'))); console.log('CardioVault workspaces verified.');\""
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "readable-stream": "^4.5.2"
  }
}
