# CardioVault web — copy to `.env.local`

# WalletConnect Cloud (https://cloud.walletconnect.com) — required for WalletConnect wallets in production
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional: Alchemy Sepolia RPC (or set full URL below)
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# App URLs for SIWE domain / URI (defaults shown in code if unset)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_HOST=localhost:3000

# iron-session (min 32 chars; required in production)
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Sepolia contract addresses (after deploy)
NEXT_PUBLIC_SEPOLIA_HEALTH_IDENTITY=
NEXT_PUBLIC_SEPOLIA_CONSENT_MANAGER=
NEXT_PUBLIC_SEPOLIA_AUDIT_TRAIL=
NEXT_PUBLIC_SEPOLIA_ZK_VERIFIER=

# RAG medical assistant (server-side only — never expose to the browser)
OPENAI_API_KEY=

# --- IPFS (Pinata) — server only (never NEXT_PUBLIC_*) ---
# Preferred: Pinata JWT from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
# Legacy alternative (also server-side only):
# PINATA_API_KEY=
# PINATA_SECRET_KEY=

# Public gateway for client reads (safe to expose)
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# S3 medical images (optional hot-cache mirror of encrypted IPFS blobs; see deploy-aws.sh)
S3_MEDICAL_IMAGES_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional override for persisted FAISS index directory (defaults to `<cwd>/data/vector-store`)
# VECTOR_STORE_PATH=
